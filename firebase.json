{
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      "node_modules.nosync",
      "node_modules/.cache",
      ".secret.local",
      ".env.demo-meuneuro",
      "*.log"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8085
    },
    "functions": {
      "port": 5055
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    }
  }
}