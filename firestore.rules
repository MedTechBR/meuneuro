rules_version = '2';
// Meu Neuro — regras do Firestore
// pedidos: o paciente (login anônimo) cria e vê o próprio pedido; só médicos (claim "medico") listam e atendem.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function medico() { return logado() && request.auth.token.medico == true; }
    function dono(d) { return logado() && d.pacienteUid == request.auth.uid; }

    match /pedidos/{id} {
      allow read: if medico() || (logado() && resource.data.pacienteUid == request.auth.uid);
      allow create: if dono(request.resource.data)
        && request.resource.data.status in ['aguardando', 'urgencia']
        && !('atendimento' in request.resource.data && request.resource.data.atendimento != null);
      // paciente só mexe enquanto o pedido está parado por urgência (ele pode refazer a triagem)
      allow update: if medico()
        || (dono(resource.data) && dono(request.resource.data)
            && resource.data.status == 'urgencia'
            && request.resource.data.status in ['aguardando', 'urgencia']
            && !('atendimento' in request.resource.data && request.resource.data.atendimento != null));
      allow delete: if false;
    }
    match /medicos/{uid} {
      allow read, write: if medico() && request.auth.uid == uid;
    }
    match /{doc=**} { allow read, write: if false; }
  }
}
